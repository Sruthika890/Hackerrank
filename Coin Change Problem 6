#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;


int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */ 
    int V, N;
    cin >> V >> N;

    vector<int> coin(N);

    for (int i = 0; i < N; i++) {
        cin >> coin[i];
    }

    const int INF = 1000000000;

    vector<int> dp(V + 1, INF);

    dp[0] = 0;

    for (int i = 1; i <= V; i++) {
        for (int j = 0; j < N; j++) {

            if (coin[j] <= i && dp[i - coin[j]] != INF) {
                dp[i] = min(dp[i],
                            dp[i - coin[j]] + 1);
            }
        }
    }

    if (dp[V] == INF)
        cout << -1;
    else
        cout << dp[V];

    return 0;
}
