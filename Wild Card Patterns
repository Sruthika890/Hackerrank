#include <iostream>
using namespace std;

int main()
{
    string s, p;
    cin >> s >> p;

    int i = 0, j = 0;

    int star = -1;
    int match = 0;

    while (i < s.length())
    {
        // Normal character or ?
        if (j < p.length() && (p[j] == '?' || p[j] == s[i]))
        {
            i++;
            j++;
        }

        // Found *
        else if (j < p.length() && p[j] == '*')
        {
            star = j;
            match = i;
            j++;
        }

        // Mismatch: use previous *
        else if (star != -1)
        {
            j = star + 1;
            match++;
            i = match;
        }

        // No * available to handle mismatch
        else
        {
            cout << 0;
            return 0;
        }
    }

    // Remaining characters in pattern must all be *
    while (j < p.length() && p[j] == '*')
        j++;

    if (j == p.length())
        cout << 1;
    else
        cout << 0;

    return 0;
}
