#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <bits/stdc++.h>
using namespace std;

int main() {
    string s;
    cin >> s;

    int n = s.size();

    // pi[i] = length of the longest proper prefix
    // of s[0...i] which is also a suffix
    vector<int> pi(n, 0);

    for (int i = 1; i < n; i++) {
        int j = pi[i - 1];

        // If characters don't match, try a shorter border
        while (j > 0 && s[i] != s[j]) {
            j = pi[j - 1];
        }

        // If characters match, extend the border
        if (s[i] == s[j]) {
            j++;
        }

        pi[i] = j;
    }

    // pi[n - 1] is the length of the longest border
    int borderLength = pi[n - 1];

    cout << s.substr(0, borderLength) << '\n';

    return 0;
}
