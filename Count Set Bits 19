#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;
int CountBits(int n)
{
    int count=0;
    while(n>0)
    {
        n&=(n-1);
        count++;
    }
    return count;
}

int main() {
   int n;
   cin>>n;
   cout<<CountBits(n); 
