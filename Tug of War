#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);
    int total = 0;

    for (int i = 0; i < n; i++) {
        cin >> a[i];
        total += a[i];
    }

    int k = n / 2;

    // dp[count][sum] = can we choose 'count' people
    // whose total weight is 'sum'?
    vector<vector<bool>> dp(k + 1,
                            vector<bool>(total / 2 + 1, false));

    dp[0][0] = true;

    for (int x : a) {
        for (int count = k; count >= 1; count--) {
            for (int sum = total / 2; sum >= x; sum--) {
                if (dp[count - 1][sum - x])
                    dp[count][sum] = true;
            }
        }
    }

    int best = 0;

    for (int sum = 0; sum <= total / 2; sum++) {
        if (dp[k][sum]) {
            best = sum;
        }
    }

    cout << total - 2 * best << endl;

    return 0;
}
