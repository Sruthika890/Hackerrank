#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;


int main() {
    string s;
    cin>>s;
    int n=s.length();
    int lps[100005]={0};
    for(int i=1,j=0;i<n;i++){
        while(j>0&&s[i]!=s[j])
        j=lps[j-1];
        if(s[i]==s[j])
        j++;
        lps[i]=j;
    }
    int period=n-lps[n-1];
    cout<<period;
    return 0;
}
